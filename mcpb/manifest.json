{
  "manifest_version": "0.2",
  "name": "dj-media-hub",
  "version": "1.0.0",
  "description": "Composite MCP server - VirtualDJ + Plex + more (cross-server workflows)",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "src/dj_media_hub/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","dj_media_hub"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "plex_to_deck", "description": "plex_to_deck" }
  ]
}
